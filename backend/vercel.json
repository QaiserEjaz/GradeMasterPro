{
  "version": 2,
  "buildCommand": "npm install && npm run build && npx prisma generate",
  "public": false,
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "NODE_ENV": "production"
  },
  "functions": {
    "src/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  }
}
