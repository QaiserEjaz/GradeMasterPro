# Backend Environment Variables

# Database Connection (Vercel Postgres or PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/grade_calculator

# JWT Secret for authentication (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Server Port
PORT=3000

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
